<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background">

    <!-- Safe area container -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/overscan_margin" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/overscan_margin" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/overscan_margin" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="@dimen/overscan_margin" />

    <!-- Header: Title and Location selector -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="@dimen/text_title"
        android:textColor="@color/ocean_text"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintEnd_toStartOf="@id/btnLocation"
        app:layout_constraintTop_toTopOf="@id/guideline_top"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"/>

    <TextView
        android:id="@+id/btnLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_location"
        android:textSize="@dimen/text_body"
        android:textColor="@color/ocean_text"
        android:background="@drawable/bg_card_selector"
        android:paddingLeft="@dimen/space_lg"
        android:paddingRight="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/cardCurrent"
        app:layout_constraintEnd_toEndOf="@id/guideline_right"
        app:layout_constraintTop_toTopOf="@id/guideline_top" />

    <!-- Current conditions card -->
    <LinearLayout
        android:id="@+id/cardCurrent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_selector"
        android:padding="@dimen/card_padding"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintEnd_toStartOf="@+id/cardSpacer"
        app:layout_constraintBottom_toTopOf="@+id/tvForecastHeader"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_lg">

        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="San Francisco"
            android:textColor="@color/ocean_text"
            android:textSize="@dimen/text_heading"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18°"
            android:textColor="@color/ocean_text"
            android:textSize="72sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="@dimen/space_md"/>

        <TextView
            android:id="@+id/tvCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partly Cloudy"
            android:textColor="@color/ocean_text_muted"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/space_sm"/>

        <LinearLayout
            android:id="@+id/rowMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feels_like"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"/>

            <TextView
                android:id="@+id/tvWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wind"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginLeft="@dimen/space_lg"/>

            <TextView
                android:id="@+id/tvHumidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/humidity"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginLeft="@dimen/space_lg"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer column between current card and forecast -->
    <View
        android:id="@+id/cardSpacer"
        android:layout_width="@dimen/space_xl"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cardCurrent"
        app:layout_constraintBottom_toBottomOf="@id/cardCurrent"
        app:layout_constraintStart_toEndOf="@id/cardCurrent"
        app:layout_constraintEnd_toStartOf="@+id/tvForecastHeader" />

    <!-- Forecast header -->
    <TextView
        android:id="@+id/tvForecastHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/next_days"
        android:textColor="@color/ocean_text"
        android:textSize="@dimen/text_heading"
        app:layout_constraintStart_toEndOf="@id/cardSpacer"
        app:layout_constraintEnd_toEndOf="@id/guideline_right"
        app:layout_constraintTop_toTopOf="@id/cardCurrent"/>

    <!-- Forecast row -->
    <LinearLayout
        android:id="@+id/rowForecast"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvForecastHeader"
        app:layout_constraintStart_toStartOf="@id/tvForecastHeader"
        app:layout_constraintEnd_toEndOf="@id/guideline_right"
        app:layout_constraintBottom_toBottomOf="@id/cardCurrent"
        android:layout_marginTop="@dimen/space_md">

        <!-- 5 forecast tiles -->
        <LinearLayout
            android:id="@+id/tileDay1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/card_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginRight="@dimen/grid_gutter">

            <TextView
                android:id="@+id/tvDay1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon"
                android:textColor="@color/ocean_text"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/tvDay1Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20°/12°"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginTop="@dimen/space_sm"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileDay2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/card_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginRight="@dimen/grid_gutter">

            <TextView
                android:id="@+id/tvDay2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tue"
                android:textColor="@color/ocean_text"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/tvDay2Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19°/11°"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginTop="@dimen/space_sm"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileDay3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/card_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginRight="@dimen/grid_gutter">

            <TextView
                android:id="@+id/tvDay3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed"
                android:textColor="@color/ocean_text"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/tvDay3Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17°/10°"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginTop="@dimen/space_sm"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileDay4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/card_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginRight="@dimen/grid_gutter">

            <TextView
                android:id="@+id/tvDay4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thu"
                android:textColor="@color/ocean_text"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/tvDay4Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18°/12°"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginTop="@dimen/space_sm"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileDay5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/card_padding"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/tvDay5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fri"
                android:textColor="@color/ocean_text"
                android:textSize="@dimen/text_body"/>

            <TextView
                android:id="@+id/tvDay5Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21°/13°"
                android:textColor="@color/ocean_text_muted"
                android:textSize="@dimen/text_small"
                android:layout_marginTop="@dimen/space_sm"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Empty/Error view -->
    <LinearLayout
        android:id="@+id/emptyContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:background="@drawable/bg_card"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintEnd_toEndOf="@id/guideline_right"
        app:layout_constraintBottom_toBottomOf="@id/guideline_bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_no_location"
            android:textColor="@color/ocean_text"
            android:textSize="@dimen/text_body"/>

        <TextView
            android:id="@+id/btnChangeLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_change_location"
            android:background="@drawable/bg_card_selector"
            android:padding="@dimen/space_md"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginTop="@dimen/space_md"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
